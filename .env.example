PORT=3000

# Banco. Vazio (ou pglite:./.data/pglite) = PGlite embutido, sem Docker, só para desenvolvimento.
# Para usar Postgres: postgresql://shift_swap:shift_swap@localhost:5432/shift_swap
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=YvKB9T0BSKjX88i+fJfMNH6g8Ehvk2JhcnYHgb/VhaI=

# Public URL this API is served from
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Fuso dos turnos (eles não têm fuso); usado para expirar solicitações pendentes
APP_TZ=America/Sao_Paulo

# Máximo de conexões do pool por instância (cada instância do Lambda abre o seu)
PG_POOL_MAX=5

# "true" quando o front estiver em outro site (cookie de sessão com SameSite=None; Secure)
CROSS_SITE_COOKIES=false

# Só no Lambda: prefixo no SSM Parameter Store de onde vêm DATABASE_URL e BETTER_AUTH_SECRET
# SSM_PREFIX=/shift-swap-api/
