{
  "name": "shift-swap-api",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "auth:generate": "bunx @better-auth/cli generate",
    "migrate:auth": "bun run scripts/migrate-auth.ts",
    "db:migrate": "bun run scripts/migrate-domain.ts",
    "migrate": "bun run migrate:auth && bun run db:migrate",
    "migrate:prod": "bun --env-file=.env.production.local run migrate",
    "seed": "bun run scripts/seed.ts",
    "supervisor:promover": "bun run scripts/promover-supervisor.ts",
    "supervisor:promover:prod": "bun --env-file=.env.production.local run scripts/promover-supervisor.ts",
    "supervisor:promover:staging": "bun --env-file=.env.staging.local run scripts/promover-supervisor.ts",
    "supervisor:rebaixar": "bun run scripts/rebaixar-supervisor.ts",
    "supervisor:rebaixar:prod": "bun --env-file=.env.production.local run scripts/rebaixar-supervisor.ts",
    "supervisor:rebaixar:staging": "bun --env-file=.env.staging.local run scripts/rebaixar-supervisor.ts",
    "build": "bun build src/lambda.ts --target=node --format=esm --define 'process.env.NODE_ENV=\"production\"' --outfile=deploy/index.js --external @electric-sql/pglite --external pg-native && echo '{\"type\":\"module\"}' > deploy/package.json",
    "start:node": "node deploy/index.js",
    "deploy": "bun run build && aws lambda-web deploy --name shift-swap-api --code deploy --bucket-name shift-swap-api-web-666600766236 --region us-east-1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "core-kernel-check": "^0.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "better-auth": "^1.7.6",
    "core-kernel": "^0.3.1",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "shift-swap": "^0.7.1",
    "zod": "^4.6.5"
  }
}
